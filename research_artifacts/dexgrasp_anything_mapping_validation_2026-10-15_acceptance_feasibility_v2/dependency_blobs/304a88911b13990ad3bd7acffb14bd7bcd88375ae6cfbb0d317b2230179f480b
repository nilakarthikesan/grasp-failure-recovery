@pytest.mark.parametrize('spacing',[1.,.5,.25])
def test_full_surface_fresh_locations_and_exact_corner_radius(spacing):
 points,normals,faces,area,rho=m.offcenter_grid(spacing);h=spacing/1000;side=round(.05/h)
 assert len(points)==6*side*side and abs(len(points)*area-.015)<1e-15
 assert np.allclose(np.linalg.norm(normals,axis=1),1)
 for axis in range(3):
  other=[i for i in range(3) if i!=axis]
  for sign in (-1,1):
   q=points[faces==f'{"XYZ"[axis]}{"+" if sign>0 else "-"}'];uv=(q[:,other]+.025)/h;cell=np.floor(uv);f=uv-cell
   assert np.allclose(f,[2/5,1/3],atol=1e-12,rtol=0)
   assert len(np.unique(cell,axis=0))==side*side
   assert np.all(q[:,axis]==sign*.025)
   corners=np.array([[0,0],[1,0],[0,1],[1,1]])
   assert np.allclose(np.linalg.norm((f[:,None]-corners)*h,axis=-1).max(axis=1),rho,atol=1e-15,rtol=0)
   assert np.all(np.abs(f-.5)>.01)
   assert np.all(np.abs(f-np.array([1/3,2/3]))>.01)
