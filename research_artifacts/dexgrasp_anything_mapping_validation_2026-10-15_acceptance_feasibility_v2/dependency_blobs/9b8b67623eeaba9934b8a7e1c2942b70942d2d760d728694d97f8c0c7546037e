   return {'landmark_metrics':landmark_metrics(error),'root':root,'forearm':forearm,'palm':palm,'delta':delta,
    'target_fk_max_entry':fkerror,'palm_chain_max_entry':chain}
  old_fixed_q=dict(fr['target_joint_targets_rad']);reference=verify(old_fixed_q,np.zeros(3),np.zeros(3))['landmark_metrics']
  if abs(reference['all_site_SSE_m2']-fr['objective_m2'])>1e-9:raise ValueError('Fixed-palm engineering baseline differs')
  baseline_q=dict(prior_free['target_joint_targets_rad']);baseline_t,baseline_w=variables_from_transform(source_palm,free_arrays['object_from_target_palm'][i])
  baseline_state=verify(baseline_q,baseline_t,baseline_w)
