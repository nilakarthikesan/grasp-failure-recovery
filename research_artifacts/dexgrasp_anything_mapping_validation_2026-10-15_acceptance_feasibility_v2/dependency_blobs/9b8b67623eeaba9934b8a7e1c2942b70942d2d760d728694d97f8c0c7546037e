  baseline_fields=evaluate(baseline_q,baseline_t,baseline_w,list(FIELDS));baseline_objective=objective_metrics(source_fields,baseline_fields)
  baseline={'candidate_id':'previous_selected_free_palm_baseline','selection_order':0,'verified_eligible_for_training_selection':True,
   'target_joint_targets_rad':baseline_q,'translation_source_palm_mm':baseline_t.tolist(),'rotation_vector_rad':baseline_w.tolist(),
   'surface_objective':baseline_objective,'landmark_metrics':baseline_state['landmark_metrics'],'no_scientific_acceptance':True}
  candidates=[baseline];attempts=[];fields_per_attempt=[]
  starts=[('previous_fixed_palm_fit',old_fixed_q,np.zeros(3),np.zeros(3)),
