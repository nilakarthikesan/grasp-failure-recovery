 source_archive=[];baseline_archive=[];attempt_archive=[];selected_archive=[]
 a.output.mkdir(parents=True);deadline=time.monotonic()+600
 for i,g in enumerate([1,3]):
  old=prior['records'][g];fr=fixed_by[g];prior_free=free_by[g]
  if not np.array_equal(free_arrays['target_joint_values'][i],np.array([prior_free['target_joint_targets_rad'][n] for n in names])):raise ValueError('Prior selected target q/order binding changed')
  manifest,rawvalues,_=profile.load_multidex_raw_export(old['native_manifest']['path'],expected_object_id='object01',expected_geometry_hash=p['geometry_content_hash'])
  raw=rawvalues[old['within_batch_sample_index']].copy();rawbytes=raw.tobytes();qs=dict(zip(names,raw[9:].tolist(),strict=True))
  if qs!=old['joint_targets_rad'] or old['source_limit_violations']:raise ValueError('Original source-valid case changed')
  sf=source_tree.forward(qs);root_source=np.eye(4);root_source[:3,:3]=base.rotation_from_6d(raw[3:9]);root_source[:3,3]=raw[:3]
