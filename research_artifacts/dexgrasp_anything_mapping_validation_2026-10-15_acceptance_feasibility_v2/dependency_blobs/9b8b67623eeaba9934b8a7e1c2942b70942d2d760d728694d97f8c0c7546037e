   if p['dependency_sha256'].get(path)!=h:raise ValueError('Backend loaded an unbound visual mesh')
  visual_source=field_matrix(backend.source_fields(queries,CAP_M),600,7)
  signed_source,signed_dummy=backend.palm_signed_fields(source_palm,source_palm,queries,CAP_M)
