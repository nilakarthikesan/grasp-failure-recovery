  'row_count':2,'source_profile_id':'dga_multidex_official_unguided_v1','starts_per_row':2,
  'start_order':['previous_fixed_palm_fit','previous_selected_free_palm_fit'],
  'sweeps':2,'block_order':list(BLOCKS),'solver':SOLVER,'cap_m':CAP_M,'signed_palm_cap_m':CAP_M,
  'training_query_spacing_m':.005,'training_query_fractions':[.5,.5],'training_query_count':600,
  'field_names':list(FIELDS),'objective':'sum_equal_field_mean_squared_native_relative_distance_difference_m2',
  'wrists':'both_original_values_preserved_exactly','strict_target_limits':True,'final_clipping':False,
  'engineering_guard_reference':'previous_fixed_palm_fit_true_all_site_maximum_and_SSE',
  'selection':'minimum_verified_surface_field_SSE_then_fixed_candidate_order',
  'maximum_wall_seconds':600,'CPU_threads':1,'algebra_atol':1e-9,
  'new_native_inference_calls':0,'physics_steps':0,'training_calls':0,'execution_eligible':False,
  'holdout_feedback':False,'acceptance_from_objective':False}
 if any(p.get(k)!=v for k,v in expected.items()):raise ValueError('Not the frozen surface-retarget implementation policy')
 if not p.get('scientific_protocol',{}).get('sha256'):raise ValueError('Parent scientific protocol must be frozen first')
 if len(p.get('site_names',[]))!=28 or p['site_names'][0]!='palm':raise ValueError('All27 finger origins and palm are mandatory engineering guard sites')

def field_matrix(values,n,field_count,signed_last=False):
 a=np.asarray(values)
 if a.shape!=(n,field_count) or a.dtype.kind not in 'fiu' or not np.isfinite(a).all():raise ValueError('Invalid distance field')
 lower=np.zeros(field_count)
 if signed_last:lower[-1]=-CAP_M
 if np.any(a<lower) or np.any(a>CAP_M):raise ValueError('Backend distance/cap contract violated')
 return a.astype(np.float64,copy=False)
def objective_metrics(source,target,names=FIELDS):
 if source.shape!=target.shape or source.ndim!=2 or len(names)!=source.shape[1]:raise ValueError('Field correspondence mismatch')
 d=target-source;means=np.mean(d*d,axis=0)
 return {'sum_field_MSE_m2':float(means.sum()),'per_field':{name:{'MSE_m2':float(means[i]),
  'maximum_clipped_difference_m':float(np.max(np.abs(d[:,i]))),'source_cap_hit_query_count':int(np.count_nonzero(np.abs(source[:,i])>=CAP_M)),
  'target_cap_hit_query_count':int(np.count_nonzero(np.abs(target[:,i])>=CAP_M))} for i,name in enumerate(names)},
  'scope':'Clipped training fields only; cap hits are lower-bound-censored, never interpreted as near or as complete distance-field equivalence.'}
def residual_vector(source,target):
 # mm/sqrt(query_count) gives the same equal-field sum MSE, in mm2.
 return ((target-source)*1000./np.sqrt(len(source))).ravel()
def landmark_metrics(error_m):
 distance=np.linalg.norm(error_m,axis=1)
 return {'maximum_site_error_m':float(distance.max()),'all_site_SSE_m2':float(np.sum(error_m*error_m)),
  'mean_site_error_m':float(distance.mean()),'per_site_error_m':distance.tolist()}
def landmark_nonregression(candidate,reference):
 return candidate['maximum_site_error_m']<=reference['maximum_site_error_m'] and candidate['all_site_SSE_m2']<=reference['all_site_SSE_m2']
def candidate_rank(c):return (c['surface_objective']['sum_field_MSE_m2'],c['selection_order'])
def transform_from_variables(source_palm,tmm,omega):
 delta=np.eye(4);delta[:3,:3]=Rotation.from_rotvec(omega).as_matrix();delta[:3,3]=np.asarray(tmm)/1000.
 return source_palm@delta,delta
def variables_from_transform(source_palm,target_palm):
 if np.array_equal(source_palm,target_palm):return np.zeros(3),np.zeros(3)
 delta=np.linalg.inv(source_palm)@target_palm
 return delta[:3,3]*1000.,Rotation.from_matrix(delta[:3,:3]).as_rotvec()

def optimize_blocks(start_q,start_tmm,start_omega,*,finger_names,joint_bounds,translation_limit_mm,
                    source_fields,evaluate,deadline):
 """Two fixed sweeps. Each training-only block is retained iff its true SSE
 does not increase. Every solver terminal, including refused ones, is logged.
 No landmark/holdout query or success label is used for optimizer feedback.
 """
 q=dict(start_q);tmm=np.array(start_tmm,copy=True);omega=np.array(start_omega,copy=True);logs=[]
 for sweep in range(2):
  for block in BLOCKS:
   if time.monotonic()>deadline:raise TimeoutError('Frozen600sec budget exceeded; no partial result is acceptance')
   if block=='palm':
    selected=list(FIELDS);indices=list(range(len(FIELDS)));initial=np.r_[tmm,omega]
    lower=np.r_[[-translation_limit_mm]*3,[-np.pi]*3];upper=np.r_[[translation_limit_mm]*3,[np.pi]*3]
    names=[]
   else:
    selected=[block];indices=[FIELDS.index(block)];names=[n for n in finger_names if n.startswith(PREFIX[block])]
    initial=np.array([q[n] for n in names]);lower=np.array([joint_bounds[n][0] for n in names]);upper=np.array([joint_bounds[n][1] for n in names])
   source=source_fields[:,indices];calls=[0]
   def state(x):
    cq=dict(q)
    if block=='palm':return cq,x[:3],x[3:]
    cq.update(zip(names,x.tolist(),strict=True));return cq,tmm,omega
   def fields(x):
    if time.monotonic()>deadline:raise TimeoutError('Frozen600sec budget exceeded')
    calls[0]+=1;cq,ct,cw=state(x);return evaluate(cq,ct,cw,selected)
   before=fields(initial);before_metric=objective_metrics(source,before,selected)
   solved=least_squares(lambda x:residual_vector(source,fields(x)),initial,bounds=(lower,upper),**SOLVER)
   after=fields(solved.x);after_metric=objective_metrics(source,after,selected)
   finite=bool(np.isfinite(solved.x).all());strict=finite and bool(np.all(solved.x>=lower) and np.all(solved.x<=upper))
   adopted=strict and after_metric['sum_field_MSE_m2']<=before_metric['sum_field_MSE_m2']
   rawq,rawt,raww=state(solved.x)
   logs.append({'sweep':sweep,'block':block,'field_names':selected,'initial_variables':initial.tolist(),
    'terminal_variables':solved.x.tolist(),'terminal_target_joint_targets_rad':rawq,
    'terminal_translation_source_palm_mm':rawt.tolist(),'terminal_rotation_vector_rad':raww.tolist(),
    'solver_success':bool(solved.success),'solver_status':int(solved.status),'solver_message':str(solved.message),
    'reported_nfev':int(solved.nfev),'reported_njev':int(solved.njev),'actual_backend_residual_evaluations':calls[0],
    'before':before_metric,'terminal':after_metric,'adopted_by_training_SSE_guard':adopted,
    'terminal_strict_variable_bounds':strict,'final_clipping':False,
    'scope':'Training-objective block selection only; not landmark/scientific/holdout acceptance.'})
   if adopted:q,tmm,omega=rawq,np.array(rawt,copy=True),np.array(raww,copy=True)
 return q,tmm,omega,logs

def main(a):
 if a.output.exists():raise FileExistsError('Never overwrite scientific/native evidence')
