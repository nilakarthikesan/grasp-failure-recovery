  if np.max(np.abs(source_palm-free_arrays['object_from_source_palm'][i]))>1e-9 or not np.array_equal(raw,free_arrays['source_hand_qpos'][i]):raise ValueError('Prior source binding changed')
  ref=bound_json(old['mapping_reference']['path'],old['mapping_reference']['sha256'])
  refpath=Path(old['mapping_reference']['path']).parent/ref['arrays']['path']
  if digest(refpath)!=ref['arrays']['sha256'] or p['dependency_sha256'].get(str(refpath))!=ref['arrays']['sha256']:raise ValueError('Unbound FP32 source visual reference')
