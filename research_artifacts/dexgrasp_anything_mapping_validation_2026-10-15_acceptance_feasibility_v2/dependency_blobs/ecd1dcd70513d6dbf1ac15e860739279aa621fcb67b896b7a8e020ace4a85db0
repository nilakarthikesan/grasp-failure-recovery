class ActualBackendControls(unittest.TestCase):
 def test_face_edge_vertex_true_distance(self):
  p=np.array([[0,0,.001],[.03,-.01,0],[-.02,-.02,0]])
  result=surface().query(p,.1,return_witnesses=True)
  np.testing.assert_allclose(result['distance_m'],[.001,.01,np.sqrt(.0002)],atol=1e-14,rtol=0)
  self.assertFalse(result['censored'].any())
 def test_identical_geometry_positive_control(self):
