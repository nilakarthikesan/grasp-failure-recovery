#!/usr/bin/env python3
"""Separate numeric-only MultiDex worker; never fresh inference or production."""
import argparse
import json
from pathlib import Path
from multidex_profile import inspect_saved_export

if __name__=='__main__':
    p=argparse.ArgumentParser(description=__doc__)
    for name in ('native-manifest','target-hand-urdf','output'):p.add_argument('--'+name,type=Path,required=True)
    p.add_argument('--object-id',required=True);p.add_argument('--geometry-hash',required=True);a=p.parse_args()
    print(json.dumps(inspect_saved_export(a.native_manifest,expected_object_id=a.object_id,expected_geometry_hash=a.geometry_hash,
        target_hand_urdf=a.target_hand_urdf,output=a.output),indent=2))
