def test_actual_sqp_core_maintains_all_component_guards_and_cached_baseline():
 import time
 names=['FFJ4','FFJ3','FFJ2','FFJ1','MFJ4','MFJ3','MFJ2','MFJ1','RFJ4','RFJ3','RFJ2','RFJ1','LFJ5','LFJ4','LFJ3','LFJ2','LFJ1','THJ5','THJ4','THJ3','THJ2','THJ1']
 source=fields();initial=state(fields());initial['fields'][:,:7]=.003;before=c.payload_digest(initial);calls=[]
 def make(x,current,block):
  st=state(current['fields']);st['variables']=x.copy();return st
 def evaluate(st,current,block):
  value=current['fields'].copy();j=c.PARTS.index(block);i=22 if block=='palm' else next(i for i,n in enumerate(names) if n.startswith(c.PREFIX[block]));value[:,j]=.003-.001*st['variables'][i];calls.append(block);return value
 selected,trace,archive=c.correct(initial,source,np.tile([0.,1.],(28,1)),make,evaluate,c.landmark_caps(metrics(),metrics()),time.monotonic()+10,finger_names=names)
 assert c.payload_digest(initial)==before and len(trace['blocks'])==12 and calls
 prior=c.component_metrics(source,initial['fields'])
 for block in trace['blocks']:
  assert c.pareto_nonregression(block['accepted_state']['component_metrics'],prior);prior=block['accepted_state']['component_metrics']
 assert c.strict_pareto_improvement(selected['component_metrics'],c.component_metrics(source,initial['fields']))
 assert sum(b['new_field_states'] for b in trace['blocks'])==len(calls)==len(archive)
 assert trace['acceptance_from_objective'] is False and trace['execution_eligible'] is False

