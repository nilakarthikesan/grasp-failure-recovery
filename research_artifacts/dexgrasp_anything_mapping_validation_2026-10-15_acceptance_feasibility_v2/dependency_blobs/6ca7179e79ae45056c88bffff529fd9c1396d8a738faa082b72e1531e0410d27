def combine_status(statuses):
 if not statuses:raise ValueError('No required tests')
 if 'FAIL' in statuses:return 'FAIL'
 return 'PASS' if all(x=='PASS' for x in statuses) else 'UNRESOLVED'

def strict_difference(intervals,identity=False):
 if len(intervals)!=2:raise ValueError('Lost and new both required')
 for v in intervals:
  lo,hi=v['lower_m2'],v['upper_m2']
  if not np.isfinite([lo,hi]).all() or lo<0 or hi<lo:raise ValueError('Malformed area bound')
 if any(v['lower_m2']>0 for v in intervals):
  if identity:raise ValueError('Identity certificate contradicts measurement')
  return 'FAIL'
 if identity or all(v['upper_m2']==0 for v in intervals):return 'PASS'
 return 'UNRESOLVED'

