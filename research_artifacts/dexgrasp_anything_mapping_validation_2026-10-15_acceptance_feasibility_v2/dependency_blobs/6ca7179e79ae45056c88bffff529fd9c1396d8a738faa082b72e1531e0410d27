 if t.ndim!=3 or t.shape[1:]!=(3,3) or not np.isfinite(t).all() or len(t)==0:raise ValueError('Missing/invalid identity geometry')
 ordered=[]
 for tri in t:
  order=np.lexsort((tri[:,2],tri[:,1],tri[:,0]));ordered.append(tri[order].ravel())
 return np.unique(np.stack(ordered),axis=0)

def triangle_set_identity(left,right):
