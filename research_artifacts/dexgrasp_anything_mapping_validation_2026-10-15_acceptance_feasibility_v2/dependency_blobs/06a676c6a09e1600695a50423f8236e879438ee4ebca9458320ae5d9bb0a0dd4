def test_block_solver_is_bounded_retains_all_steps_and_never_changes_wrists():
 fingers=['FFJ4','FFJ3','FFJ2','FFJ1','MFJ4','MFJ3','MFJ2','MFJ1','RFJ4','RFJ3','RFJ2','RFJ1','LFJ5','LFJ4','LFJ3','LFJ2','LFJ1','THJ5','THJ4','THJ3','THJ2','THJ1']
 q={n:.1 for n in fingers};q.update(WRJ2=.12,WRJ1=-.16);before=dict(q)
 source=np.zeros((3,8));bounds={n:(-1.,1.) for n in fingers}
 def evaluate(values,tmm,omega,selected):
  result=[]
  for name in selected:
   if name in m.PREFIX:value=values[m.PREFIX[name]+('J5' if name in ['little','thumb'] else 'J4')]**2*.001
   elif name=='declared_palm_signed_union':value=tmm[0]*.001
   else:value=np.linalg.norm(tmm)*.001
   result.append(np.full(3,value))
  return np.column_stack(result)
 fitted,t,w,logs=m.optimize_blocks(q,np.array([.3,0.,0.]),np.zeros(3),finger_names=fingers,joint_bounds=bounds,
  translation_limit_mm=1.,source_fields=source,evaluate=evaluate,deadline=time.monotonic()+30)
 assert q==before and fitted['WRJ2']==.12 and fitted['WRJ1']==-.16
 assert len(logs)==12 and [x['block'] for x in logs]==list(m.BLOCKS)*2
 assert all(x['reported_nfev']<=10 for x in logs)
 assert all(not x['adopted_by_training_SSE_guard'] or x['terminal']['sum_field_MSE_m2']<=x['before']['sum_field_MSE_m2'] for x in logs)
 assert m.objective_metrics(source,evaluate(fitted,t,w,list(m.FIELDS)))['sum_field_MSE_m2']<=m.objective_metrics(source,evaluate(q,np.array([.3,0.,0.]),np.zeros(3),list(m.FIELDS)))['sum_field_MSE_m2']

