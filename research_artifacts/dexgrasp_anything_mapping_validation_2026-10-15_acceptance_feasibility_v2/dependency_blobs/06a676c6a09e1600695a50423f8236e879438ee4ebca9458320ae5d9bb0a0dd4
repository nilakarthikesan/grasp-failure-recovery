def test_identity_palm_parameterization_is_exact_and_actual_delta_is_explicit():
 source=np.eye(4);source[:3,:3]=[[0.,-1.,0.],[1.,0.,0.],[0.,0.,1.]];source[:3,3]=[.02,-.03,.08]
 t,w=m.variables_from_transform(source,source.copy())
 assert np.array_equal(t,np.zeros(3)) and np.array_equal(w,np.zeros(3))
 target,delta=m.transform_from_variables(source,[1.,-.5,.2],[.01,-.02,.03])
 assert not np.allclose(source,target)
 np.testing.assert_allclose(source@delta,target,atol=0,rtol=0)

