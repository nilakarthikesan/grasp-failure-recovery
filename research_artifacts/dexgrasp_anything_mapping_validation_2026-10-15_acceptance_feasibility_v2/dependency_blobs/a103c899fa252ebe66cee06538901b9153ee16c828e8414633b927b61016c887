 for k in ['q','landmark_metrics','surface_loss','refusal_reason','target_fk_max_entry','palm_chain_max_entry','field_archive_key']:
  if k in s:result[k]=s[k]
 for k in ['palm','root','forearm','delta']:
  if k in s:result[k]=np.asarray(s[k]).tolist()
 return result

def guarded_backtracking(current,proposal_variables,guard,evaluate,source_fields):
 """ALL11positive alphas are guarded before evaluation. Alpha0 is the exact
 current object and fields; never compute0*(proposal-current), recompose orquery.
 """
 if current.get('feasible') is not True:raise ValueError('Current accepted state must already be certified feasible')
 if 'fields' not in current or 'surface_loss' not in current:raise ValueError('Exact current field cache required')
 if not np.isfinite(current['variables']).all() or loss(source_fields,current['fields'])!=current['surface_loss']:raise ValueError('Malformed/inconsistent exact current cache')
 original=current['variables'].tobytes();cached=current['fields'].tobytes();proposal=np.asarray(proposal_variables)
 best=current;best_alpha=0.;records=[]
 for order,alpha in enumerate(ALPHAS[:-1]):
  entry={'alpha':alpha,'fixed_order':order,'query_scope':'guarded_backtracking_candidate_not_yet_adopted',
   'guard_checked_before_surface':False,'surface_evaluated':False,'adopted':False}
  if proposal.shape!=current['variables'].shape or not np.isfinite(proposal).all():
   entry.update({'refusal_reason':'Nonfinite/malformed proposal; no interpolation, guard or fieldquery attempted.','proposal_variables':safe_vector(proposal.ravel())});records.append(entry);continue
  variables=current['variables']+alpha*(proposal-current['variables'])
  candidate=guard(variables);entry['guard_checked_before_surface']=True;entry['state']=state_summary(candidate)
  if candidate.get('feasible') is not True:
   entry['refusal_reason']=candidate.get('refusal_reason','Hard guard refused');records.append(entry);continue
  candidate['fields']=evaluate(candidate);candidate['surface_loss']=loss(source_fields,candidate['fields'])
  entry['surface_evaluated']=True;entry['surface_loss']=candidate['surface_loss']
  entry['field_archive_key']=candidate.get('field_archive_key');entry['state']=state_summary(candidate)
  entry['training_nonincrease']=candidate['surface_loss']<=current['surface_loss']
  if not entry['training_nonincrease']:entry['refusal_reason']='Training surface objective increased; feasible candidate retained but not adopted.'
  # Strict improvement implements exact-current preference on ties. Fixedalpha
  # order breaks ties between noncurrent improving candidates.
  if entry['training_nonincrease'] and candidate['surface_loss']<best['surface_loss']:
   best=candidate;best_alpha=alpha
  records.append(entry)
 records.append({'alpha':0.,'fixed_order':11,'query_scope':'exact_cached_current_state','guard_checked_before_surface':False,
  'guard_certificate_reused_from_current':True,'surface_evaluated':False,'cached_fields_reused':True,
  'surface_loss':current['surface_loss'],'state':state_summary(current),'adopted':False})
 if current['variables'].tobytes()!=original or current['fields'].tobytes()!=cached:raise ValueError('Proposal/backtracking mutated exact current state')
 for entry in records:entry['adopted']=entry['alpha']==best_alpha
 return best,{'alphas':records,'selected_alpha':best_alpha,'current_preference_on_exact_ties':True,
  'selection':'minimum feasible trainingloss over ALLfixedalphas; current wins exactties',
  'accepted_state':state_summary(best),'accepted_fields_are_cached':best is current}

def proposal_sweep(current,source_fields,evaluate,fingers,bounds,limit_mm,deadline,legacy):
 """ONE six-block workspace sweep. Its retained blocks are SEARCH proposals,
 may be landmark-infeasible, and never count as accepted iterates.
 """
 x=current['variables'].copy();nq=len(fingers);history=[]
 for block in BLOCKS:
  if time.monotonic()>deadline:raise TimeoutError('Frozen600sec budget exceeded')
  if block=='palm':indices=list(range(nq,nq+6));selected=list(FIELDS);columns=list(range(8));lower=np.r_[[-limit_mm]*3,[-np.pi]*3];upper=-lower
  else:
   indices=[i for i,n in enumerate(fingers) if n.startswith(PREFIX[block])];selected=[block];columns=[FIELDS.index(block)]
   lower=np.array([bounds[fingers[i]][0] for i in indices]);upper=np.array([bounds[fingers[i]][1] for i in indices])
  initial=x[indices].copy();calls=[0]
  def fields(y):
   if time.monotonic()>deadline:raise TimeoutError('Frozen600sec budget exceeded')
   calls[0]+=1;trial=x.copy();trial[indices]=y
   return evaluate(trial,selected,'proposal_workspace_landmark_feasibility_NOT_enforced')
  source=source_fields[:,columns];before=fields(initial)
  solved=least_squares(lambda y:legacy.residual_vector(source,fields(y)),initial,bounds=(lower,upper),**SOLVER)
  after=fields(solved.x);before_loss=loss(source,before);after_loss=loss(source,after)
  strict=np.isfinite(solved.x).all() and np.all(solved.x>=lower) and np.all(solved.x<=upper)
  retained=bool(strict and after_loss<=before_loss)
  terminal=x.copy();terminal[indices]=solved.x
  history.append({'block':block,'scope':'UNCONSTRAINED_LANDMARK_PROPOSAL_WORKSPACE_NOT_ACCEPTED_ITERATE',
   'initial_block_variables':safe_vector(initial),'terminal_variables':safe_vector(terminal),
   'source_field_names':selected,'before_field_loss_m2':before_loss,'terminal_field_loss_m2':after_loss,
   'workspace_block_retained_by_training_loss':retained,'terminal_strict_variable_bounds':bool(strict),
   'solver_success':bool(solved.success),'solver_status':int(solved.status),'solver_message':str(solved.message),
   'reported_nfev':int(solved.nfev),'reported_njev':int(solved.njev),'proposal_backend_evaluations':calls[0],
   'landmark_feasibility_not_claimed':True})
  if retained:x=terminal
 return x,history,(after if retained else before)

