def manufactured():
 robot=audit.model(TARGET)
 q={n:float(np.mean([robot['joints'][n]['limit']['lower'],robot['joints'][n]['limit']['upper']])) for n in base.SOURCE_JOINT_NAMES}
 q.update(WRJ2=.12,WRJ1=-.16)
 return robot,q

def test_identity_manufactured_fit_and_fixed_nonzero_wrists():
 robot,q=manufactured();saved=dict(q);frames=audit.independent_fk(robot,q)
 fitted,projection,logs=m.solve_fingers(frames,robot,q,audit.independent_fk)
 assert q==saved and projection==[] and not m.outside(robot,fitted)
 assert fitted['WRJ1']==-.16 and fitted['WRJ2']==.12
 assert sum(x['objective_after_m2'] for x in logs)<1e-24
 assert [x['finger'] for x in logs]==list(m.FINGERS)
 assert all('not a certified global optimum' in x['claim'] for x in logs)

def test_outside_original_is_only_projected_as_logged_start():
 robot,q=manufactured();q['FFJ4']=.4;saved=dict(q)
 frames=audit.independent_fk(robot,q)
 fitted,projection,logs=m.solve_fingers(frames,robot,q,audit.independent_fk)
 assert q==saved and q['FFJ4']==.4 and not m.outside(robot,fitted)
 assert projection==[{'joint':'FFJ4','original_rad':.4,'diagnostic_initial_rad':robot['joints']['FFJ4']['limit']['upper']}]
 assert fitted['WRJ1']==q['WRJ1'] and fitted['WRJ2']==q['WRJ2']
 assert logs[0]['objective_after_m2']>0
 assert fitted['FFJ4']<=robot['joints']['FFJ4']['limit']['upper']

def test_palm_fixed_world_and_actual_forearm_have_distinct_semantics():
 robot,q=manufactured();frames=audit.independent_fk(robot,q)
 palm=np.eye(4);palm[:3,:3]=np.array([[0.,-1.,0.],[1.,0.,0.],[0.,0.,1.]])
 palm[:3,3]=[.07,-.02,.1]
 world=palm@np.linalg.inv(frames['palm']);forearm=world@frames['forearm']
 assert np.max(np.abs(world@frames['palm']-palm))<1e-14
 assert np.max(np.abs(forearm@np.linalg.inv(frames['forearm'])@frames['palm']-palm))<1e-14
 assert not np.allclose(world,forearm)

