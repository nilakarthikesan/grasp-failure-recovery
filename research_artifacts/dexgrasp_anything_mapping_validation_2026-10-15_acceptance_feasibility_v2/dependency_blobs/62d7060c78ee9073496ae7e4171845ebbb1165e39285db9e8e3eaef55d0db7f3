#!/usr/bin/env python3
"""Bounded development-only free-palm fit. No geometry/contact objective."""
import argparse
from datetime import datetime, timezone
import hashlib
import importlib.util
import json
from pathlib import Path
import sys
import time
import numpy as np
import scipy
from scipy.optimize import minimize
from scipy.spatial.transform import Rotation
sys.dont_write_bytecode=True

POLICY_ID='dga_multidex_free_palm_minimax_development_v1'
FINGERS=('ff','mf','rf','lf','th')
SOLVER={'method':'SLSQP','options':{'maxiter':200,'ftol':1e-10,'eps':1.4901161193847656e-8,'disp':False}}

def digest(path):
 h=hashlib.sha256()
 with Path(path).open('rb') as f:
  for b in iter(lambda:f.read(1024*1024),b''):h.update(b)
 return 'sha256:'+h.hexdigest()
def read_bound(path,expected):
 if digest(path)!=expected:raise ValueError('Bound dependency changed: '+str(path))
 return json.loads(Path(path).read_text())
def module(name,path):
 spec=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(spec);sys.modules[name]=m;spec.loader.exec_module(m);return m
def write_json(path,value):
 if Path(path).exists():raise FileExistsError(path)
 Path(path).write_text(json.dumps(value,indent=2,allow_nan=False)+'\n')

def require_policy(p):
 expected={'schema_version':POLICY_ID,'status':'FROZEN_PREOPTIMIZATION','global_sample_indices':[1,3],
  'row_count':2,'starts_per_row':2,'source_profile_id':'dga_multidex_official_unguided_v1',
  'objective':'minimum_maximum_euclidean_all_common_finger_origins_plus_palm_error_m',
  'secondary_guard':'true_all_site_SSE_no_worse_than_previous_fixed_palm_baseline',
  'maximum_guard':'true_maximum_site_error_no_worse_than_previous_fixed_palm_baseline',
  'wrists':'both_original_values_preserved_exactly','final_clipping':False,
  'selection':'minimum_true_maximum_then_true_SSE_then_fixed_start_order',
  'start_order':['previous_fixed_palm_fit','native_finger_target_box_projection'],
  'solver':SOLVER,'algebra_atol':1e-9,'execution_eligible':False,
  'scientific_acceptance_threshold':None,'approximate_contact_adequacy':'UNRESOLVED',
  'surface_queries':0,'object_contact_objective_terms':0,'physics_steps':0,'native_inference_calls':0,
  'holdout':{'grid_cell_widths_m':[.002,.001],'query_fractions':[1/3,2/3],
   'patch_radius':'2*sqrt(2)*h/3','bands_m':[.0005,.001,.002],'no_feedback':True}}
 if any(p.get(k)!=v for k,v in expected.items()):raise ValueError('Not the frozen free-palm development policy')
 if len(p.get('site_names',[]))!=28 or p['site_names'][0]!='palm':raise ValueError('Palm and all27 finger origins required')

def positional_metrics(error_m):
 errors=np.linalg.norm(error_m,axis=1)
 return {'maximum_site_error_m':float(errors.max()),'all_site_SSE_m2':float(np.sum(error_m*error_m)),
  'mean_site_error_m':float(errors.mean()),'per_site_error_m':errors.tolist()}
def nonregression(metrics,baseline):
 return metrics['maximum_site_error_m']<=baseline['maximum_site_error_m'] and metrics['all_site_SSE_m2']<=baseline['all_site_SSE_m2']
def rank_key(record):
 return (record['metrics']['maximum_site_error_m'],record['metrics']['all_site_SSE_m2'],record['selection_order'])
def relative_sites(frames,names):
 inverse=np.linalg.inv(frames['palm'])
 return np.stack([np.zeros(3) if n=='palm' else (inverse@frames[n])[:3,3] for n in names])
def palm_delta(translation_mm,rotation_vector):
 out=np.eye(4);out[:3,:3]=Rotation.from_rotvec(rotation_vector).as_matrix();out[:3,3]=np.asarray(translation_mm)/1000.
 return out
def errors_mm(source_points_m,target_points_m,translation_mm,rotation_vector):
 R=Rotation.from_rotvec(rotation_vector).as_matrix()
 return (target_points_m@R.T-source_points_m)*1000.+np.asarray(translation_mm)

def optimize_attempt(qstart,qbounds,target_sites,source_points_m,baseline,deadline):
 """One predeclared start; all constraints are numerical, not acceptance."""
 nq=len(qstart);maximum_mm=baseline['maximum_site_error_m']*1000.;sse_mm2=baseline['all_site_SSE_m2']*1e6
 cache={};calls=[0]
 def residual(x):
  if time.monotonic()>deadline:raise TimeoutError('Frozen total fit wall limit exceeded')
  calls[0]+=1;key=x[:nq].tobytes()
  if key not in cache:
   if len(cache)>64:cache.clear()
   cache[key]=target_sites(x[:nq])
  return errors_mm(source_points_m,cache[key],x[nq:nq+3],x[nq+3:nq+6])
 def constraints(x):
  e=residual(x);squared=np.sum(e*e,axis=1)
  return np.r_[x[-1]**2-squared,sse_mm2-float(np.sum(squared)),np.pi**2-float(x[nq+3:nq+6]@x[nq+3:nq+6])]
 initial=np.r_[qstart,np.zeros(6),maximum_mm]
 bounds=[tuple(x) for x in qbounds]+[(-maximum_mm,maximum_mm)]*3+[(-np.pi,np.pi)]*3+[(0.,maximum_mm)]
 gradient=np.zeros(len(initial));gradient[-1]=1.
 result=minimize(lambda x:float(x[-1]),initial,jac=lambda x:gradient,bounds=bounds,
  constraints=[{'type':'ineq','fun':constraints}],**SOLVER)
 final_error=residual(result.x)
 return result,{'initial_variables':initial.tolist(),'final_variables':result.x.tolist(),
  'solver_success':bool(result.success),'solver_status':int(result.status),'solver_message':str(result.message),
  'reported_iterations':int(result.nit),'reported_nfev':int(result.nfev),'constraint_residual_calls':calls[0],
  'solver_epigraph_mm':float(result.x[-1]),'minimum_solver_constraint':float(np.min(constraints(result.x))),
  'solver_internal_recomputed_metrics':positional_metrics(final_error/1000.),
  'interpretation':'One bounded local minimax attempt; solver success/epigraph never substitutes for independent true-metric checks.'}

def main(a):
 if a.output.exists():raise FileExistsError('Never overwrite native/baseline/development evidence')
 p=read_bound(a.policy,a.policy_sha256);require_policy(p)
 for path,h in p['dependency_sha256'].items():
  if digest(path)!=h:raise ValueError('Dependency changed before fit: '+path)
 if digest(__file__)!=p['code_hashes']['free_palm_fit']:raise ValueError('Current fit code not frozen')
 sys.path.insert(0,str(Path(p['repository'])/'src'))
 profile=module('free_palm_multidex_profile',p['code_paths']['profile']);base=profile.original
 audit=module('free_palm_independent_fk',p['code_paths']['independent_fk'])
 prior=read_bound(p['prior_validation']['path'],p['prior_validation']['sha256'])
 previous=read_bound(p['previous_fit_report']['path'],p['previous_fit_report']['sha256'])
 old_by_index={r['global_sample_index']:r for r in previous['records']}
 source=audit.model(Path(p['source_hand_urdf']));target=audit.model(Path(p['target_hand_urdf']))
 st=base.DGAHandTree(Path(p['source_hand_urdf']),base.SOURCE_URDF_SHA256)
 tt=base.DGAHandTree(Path(p['target_hand_urdf']),base.TARGET_URDF_SHA256)
 names=base.SOURCE_JOINT_NAMES;fingers=[n for n in names if not n.startswith('WRJ')]
 sites=p['site_names']
 expected=['palm']+sorted(n for n in source['links'] if n in target['links'] and n.startswith(FINGERS))
 if sites!=expected or p['joint_names']!=list(names):raise ValueError('Frozen site/joint order differs')
 bounds=np.array([[target['joints'][n]['limit']['lower'],target['joints'][n]['limit']['upper']] for n in fingers])
 sz=audit.independent_fk(source,dict.fromkeys(names,0.));tz=audit.independent_fk(target,dict.fromkeys(names,0.))
 C={n:(sz['palm'][:3,:3].T@sz[n][:3,:3]).T@(tz['palm'][:3,:3].T@tz[n][:3,:3]) for n in sites}
 arrays={k:[] for k in ['source_hand_qpos','target_joint_values','object_from_source_forearm','object_from_source_palm','object_from_target_palm','object_from_target_root_world','object_from_target_forearm','source_palm_from_target_palm']}
 records=[];a.output.mkdir(parents=True);deadline=time.monotonic()+p['maximum_wall_seconds']
 for global_index in p['global_sample_indices']:
  old=prior['records'][global_index];fixed=old_by_index[global_index]
  manifest,rawvalues,_=profile.load_multidex_raw_export(old['native_manifest']['path'],expected_object_id='object01',expected_geometry_hash=p['geometry_content_hash'])
  row=rawvalues[old['within_batch_sample_index']].copy();rawbytes=row.tobytes();qs=dict(zip(names,row[9:].tolist(),strict=True))
  if qs!=old['joint_targets_rad'] or old['source_limit_violations']:raise ValueError('Original source-valid rows changed')
  sf=audit.independent_fk(source,qs);checked_source=st.forward(qs)
  if max(np.max(np.abs(sf[n]-checked_source[n])) for n in sf)>p['algebra_atol']:raise ValueError('Source independent FK discrepancy')
  native_root=np.eye(4);native_root[:3,:3]=base.rotation_from_6d(row[3:9]);native_root[:3,3]=row[:3]
  native_root=base.proper_transform(np.asarray(manifest.object_from_input)@native_root)
  source_palm=base.proper_transform(native_root@checked_source['palm'])
  desired=relative_sites(sf,sites)
  qbaseline=dict(fixed['target_joint_targets_rad']);tt.forward(qbaseline)
  if any(qbaseline[n]!=qs[n] for n in ['WRJ2','WRJ1']):raise ValueError('Previous baseline changed wrists')
  baseline_q=np.array([qbaseline[n] for n in fingers])
  cache={}
  def target_sites(qarray):
   key=qarray.tobytes()
   if key not in cache:
    if len(cache)>64:cache.clear()
    q=dict(qs);q.update(zip(fingers,qarray.tolist(),strict=True));cache[key]=relative_sites(audit.independent_fk(target,q),sites)
   return cache[key]
  def verify(qarray,tmm,omega):
   if not np.all(np.isfinite(np.r_[qarray,tmm,omega])):raise ValueError('Nonfinite candidate')
   q=dict(qs);q.update(zip(fingers,qarray.tolist(),strict=True))
   if q['WRJ2']!=qs['WRJ2'] or q['WRJ1']!=qs['WRJ1']:raise ValueError('Original wrist changed')
   if any(not bounds[i,0]<=v<=bounds[i,1] for i,v in enumerate(qarray)):raise ValueError('Strict target limit violation; no final clipping')
   if float(omega@omega)>np.pi**2:raise ValueError('Nonprincipal rotation vector')
   frames=tt.forward(q);ind=audit.independent_fk(target,q)
   fkerror=max(float(np.max(np.abs(frames[n]-ind[n]))) for n in frames)
   if fkerror>p['algebra_atol']:raise ValueError('Target independent FK discrepancy')
   delta=base.proper_transform(palm_delta(tmm,omega));palm=base.proper_transform(source_palm@delta)
   root=base.proper_transform(palm@np.linalg.inv(frames['palm']));forearm=base.proper_transform(root@frames['forearm'])
   err=np.stack([(root@frames[n])[:3,3]-(native_root@checked_source[n])[:3,3] for n in sites])
   # Exact chain reconstruction is checked separately from displacement to source.
   chainerror=float(np.max(np.abs(root@frames['palm']-palm)))
   if chainerror>p['algebra_atol']:raise ValueError('Target root-to-palm reconstruction failed')
   return q,frames,{'metrics':positional_metrics(err),'delta':delta,'palm':palm,'root':root,'forearm':forearm,
    'target_fk_max_entry':fkerror,'palm_chain_max_entry':chainerror,'errors_m':err}
  _,_,baseline_state=verify(baseline_q,np.zeros(3),np.zeros(3));baseline=baseline_state['metrics']
  if abs(baseline['all_site_SSE_m2']-fixed['objective_m2'])>p['algebra_atol']:raise ValueError('Previous baseline objective differs')
  baseline_record={'candidate_id':'baseline_previous_fixed_palm','selection_order':0,'verified_feasible':True,
   'metrics':baseline,'target_joint_targets_rad':qbaseline,'translation_mm':[0.,0.,0.],'rotation_vector_rad':[0.,0.,0.],
   'interpretation':'Unmodified earlier development fit baseline; no new optimizer call.'}
  candidates=[baseline_record];attempts=[]
  projected=np.minimum(np.maximum(np.array([qs[n] for n in fingers]),bounds[:,0]),bounds[:,1])
  projection=[{'joint':n,'native_rad':qs[n],'diagnostic_initial_rad':float(v)} for n,v in zip(fingers,projected) if qs[n]!=float(v)]
  starts=[('previous_fixed_palm_fit',baseline_q),('native_finger_target_box_projection',projected)]
  for start_index,(start_id,qstart) in enumerate(starts):
   solved,log=optimize_attempt(qstart,bounds,target_sites,desired,baseline,deadline)
   nq=len(fingers);qarray=solved.x[:nq];tmm=solved.x[nq:nq+3];omega=solved.x[nq+3:nq+6]
   result={'candidate_id':start_id,'selection_order':start_index+1,'start_index':start_index,'solver_log':log,
    'diagnostic_projection':projection if start_index==1 else [],'projection_is_not_native_or_accepted_output':True,
    'translation_mm':tmm.tolist(),'rotation_vector_rad':omega.tolist(),
    'target_joint_targets_rad':dict(zip(names,[qs[n] if n.startswith('WRJ') else float(qarray[fingers.index(n)]) for n in names],strict=True))}
   try:
    _,_,state=verify(qarray,tmm,omega);result['metrics']=state['metrics']
    result['strict_target_domain_and_chain_valid']=True
    result['no_worse_true_maximum_and_SSE']=nonregression(state['metrics'],baseline)
    result['verified_feasible']=result['no_worse_true_maximum_and_SSE']
    if not result['verified_feasible']:result['refusal_reason']='True maximum or all-site SSE regressed; solver status/epigraph is not used as substitute.'
   except (ValueError,base.DGAContractError) as exc:
    result['verified_feasible']=False;result['refusal_reason']=str(exc)
   write_json(a.output/f'row_{global_index}_attempt_{start_index}.json',result);attempts.append(result)
   if result['verified_feasible']:candidates.append(result)
  selected=min(candidates,key=rank_key)
  qfit=dict(selected['target_joint_targets_rad']);qarray=np.array([qfit[n] for n in fingers])
  qfit,frames,state=verify(qarray,np.array(selected['translation_mm']),np.array(selected['rotation_vector_rad']))
  if not nonregression(state['metrics'],baseline):raise ValueError('Fresh terminal candidate guard failed')
  if row.tobytes()!=rawbytes or not np.array_equal(row,rawvalues[old['within_batch_sample_index']]):raise ValueError('Native row mutated')
  per_site={n:{'baseline_error_m':float(baseline['per_site_error_m'][i]),'selected_error_m':float(state['metrics']['per_site_error_m'][i]),
   'source_error_vector_object_m':state['errors_m'][i].tolist(),
   'raw_frame_rotation_error_rad':audit.rotation_distance((native_root@checked_source[n])[:3,:3],(state['root']@frames[n])[:3,:3]),
   'palm_relative_zero_gauge_rotation_error_rad':audit.rotation_distance((native_root@checked_source[n])[:3,:3]@C[n],(state['root']@frames[n])[:3,:3])} for i,n in enumerate(sites)}
  record={'global_sample_index':global_index,'batch_index':old['batch_index'],'within_batch_sample_index':old['within_batch_sample_index'],
   'seed':old['seed'],'source_profile_id':p['source_profile_id'],'native_manifest':old['native_manifest'],
   'raw_output_sha256':manifest.output.sha256,'raw33_row_sha256':'sha256:'+hashlib.sha256(rawbytes).hexdigest(),
   'original_joint_targets_rad':qs,'target_joint_targets_rad':qfit,'original_mapping_status':old['mapping_status'],
   'original_source_limit_violations':old['source_limit_violations'],'original_target_limit_violations':old['target_limit_violations'],
   'final_target_limit_violations':[],'both_original_wrists_preserved':True,'source_palm_preserved':bool(np.array_equal(state['delta'],np.eye(4))),
   'source_palm_is_immutable_reference':True,'target_palm_is_explicit_new_placement':True,
   'baseline':baseline_record,'attempts':attempts,'selected_candidate_id':selected['candidate_id'],'metrics':state['metrics'],
   'palm_displacement':{'translation_source_palm_m':state['delta'][:3,3].tolist(),'translation_norm_m':float(np.linalg.norm(state['delta'][:3,3])),
    'rotation_vector_rad':selected['rotation_vector_rad'],'rotation_angle_rad':float(np.linalg.norm(selected['rotation_vector_rad']))},
   'per_site':per_site,'independent_verification':{'target_fk_max_entry':state['target_fk_max_entry'],'target_palm_chain_max_entry':state['palm_chain_max_entry']},
   'source_reference_prior_status':{'native_default':old['native_default_runtime_reconstruction']['status'],'declared_fp32':old['fp32_mapping_reference_reconstruction']['status']},
   'target_root_link':'world','execution_eligible':False,'scientific_acceptance':'UNRESOLVED',
   'scope':'Explicit new per-grasp free-palm retarget; all per-site/palm tradeoffs reported. Fixed-palm lower-bound certificate is unchanged and does not apply to free-palm candidates.'}
  records.append(record)
  for key,value in [('source_hand_qpos',row),('target_joint_values',np.array([qfit[n] for n in names])),('object_from_source_forearm',native_root),('object_from_source_palm',source_palm),('object_from_target_palm',state['palm']),('object_from_target_root_world',state['root']),('object_from_target_forearm',state['forearm']),('source_palm_from_target_palm',state['delta'])]:arrays[key].append(value)
 for path,h in p['dependency_sha256'].items():
  if digest(path)!=h:raise ValueError('Dependency changed during fit: '+path)
 if {'torch','mujoco','isaacgym','envs','pybullet'}&set(sys.modules):raise ValueError('Forbidden model/simulator import')
 npz=a.output/'fit_poses.npz';np.savez(npz,global_sample_indices=np.array(p['global_sample_indices'],dtype=np.int64),**{k:np.stack(v) for k,v in arrays.items()})
 report={'schema_version':POLICY_ID,'status':'COMPLETE_DEVELOPMENT_MINIMAX_NO_ACCEPTANCE','policy_sha256':a.policy_sha256,
  'created_at_utc':datetime.now(timezone.utc).isoformat(),'source_profile_id':p['source_profile_id'],'records':records,
  'arrays':{'path':npz.name,'sha256':digest(npz)},'joint_names':list(names),'site_names':sites,
  'previous_fit_report':p['previous_fit_report'],'prior_validation':p['prior_validation'],
  'original_accounting':prior['accounting'],'original_surface_selection':prior['surface_selection'],
  'runtime':{'numpy':np.__version__,'scipy':scipy.__version__},'solver':SOLVER,'dependency_sha256':p['dependency_sha256'],
  'execution_eligible':False,'approximate_contact_adequacy':'UNRESOLVED','scientific_acceptance_threshold':None,
  'selection':'Independent true maximum then SSE, fixed start order; prior fixed-palm baseline always retained.',
  'scope':'Landmark minimax/SSE nonregression is an engineering diagnostic, not per-site/palm nonregression, physical contact or surface equivalence. No holdout-query feedback is permitted.',
  'zero_step_evidence':{'native_inference_calls':0,'checkpoint_loads':0,'physics_steps':0,'surface_queries':0,'triangle_operations':0,'object_contact_objective_terms':0,'training_calls':0}}
 out=a.output/'free_palm_fit_report.json';write_json(out,report)
 print(json.dumps({'report':str(out),'sha256':digest(out),'arrays_sha256':digest(npz),'cases':[{'global_sample_index':r['global_sample_index'],'selected':r['selected_candidate_id'],'metrics':r['metrics'],'palm':r['palm_displacement']} for r in records],'execution_eligible':False}))

if __name__=='__main__':
 c=argparse.ArgumentParser();c.add_argument('--policy',type=Path,required=True);c.add_argument('--policy-sha256',required=True);c.add_argument('--output',type=Path,required=True);main(c.parse_args())
