def digest(path):
 h=hashlib.sha256()
 with Path(path).open('rb') as f:
  for b in iter(lambda:f.read(1024*1024),b''):h.update(b)
 return 'sha256:'+h.hexdigest()

def require_identity(value):
 expected={'source_profile_id':PROFILE_ID,'checkpoint_sha256':CHECKPOINT_SHA256,
  'dataset_name':DATASET_NAME,'normalizer_source_sha256':NORMALIZER_SHA256}
 if any(value.get(k)!=v for k,v in expected.items()):raise ValueError('Separate atomic MultiDex identity mismatch')

