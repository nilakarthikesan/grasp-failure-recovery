def test_source_palm_target_palm_world_and_true_forearm_are_distinct():
 repo=Path('/Users/nilakarthikesan/.codex/worktrees/partner-simulation-review/grasp-failure-prediction')
 sys.path.insert(0,str(repo/'src'))
 from grasp_failure_prediction.proposals import dexgrasp_anything as base
 target=base.DGAHandTree(repo/'third_party/dex-urdf/robots/hands/shadow_hand/shadow_hand_right.urdf',base.TARGET_URDF_SHA256)
 q=dict.fromkeys(base.SOURCE_JOINT_NAMES,0.);q.update(WRJ2=.12,WRJ1=-.16)
 before=dict(q);f=target.forward(q)
 source_palm=np.eye(4);source_palm[:3,3]=[.03,-.02,.07]
 delta=m.palm_delta([1.,-.5,.2],[.01,-.02,.03]);palm=source_palm@delta
 world=palm@np.linalg.inv(f['palm']);forearm=world@f['forearm']
 assert q==before and q['WRJ1']==-.16 and q['WRJ2']==.12
 assert not np.allclose(palm,source_palm) and not np.allclose(world,forearm)
 np.testing.assert_allclose(world@f['palm'],palm,atol=1e-14,rtol=0)
 np.testing.assert_allclose(forearm@np.linalg.inv(f['forearm'])@f['palm'],palm,atol=1e-14,rtol=0)

