def test_palm_cannot_disappear_from_site_metric():
 source=np.array([[0.,0.,0.],[0.,0.,.05],[.01,.01,.07]])
 target=source.copy();target[1:,0]+=.002
 untouched=m.errors_mm(source,target,np.zeros(3),np.zeros(3))/1000
 moved=m.errors_mm(source,target,[-2.,0.,0.],np.zeros(3))/1000
 assert untouched[0].tolist()==[0.,0.,0.]
 assert moved[0].tolist()==[-.002,0.,0.]
 assert m.positional_metrics(untouched)['maximum_site_error_m']<.00200000000001
 assert m.positional_metrics(moved)['maximum_site_error_m']==.002

def test_manufactured_minimax_counts_palm_and_improves_true_max():
 source=np.array([[0.,0.,0.],[0.,0.,.05],[.01,.01,.07]])
 target=source.copy();target[1:,0]+=.002
 baseline=m.positional_metrics(target-source)
 result,log=m.optimize_attempt(np.empty(0),np.empty((0,2)),lambda q:target,source,baseline,time.monotonic()+10)
 error=m.errors_mm(source,target,result.x[:3],result.x[3:6])/1000
 metrics=m.positional_metrics(error)
 assert m.nonregression(metrics,baseline)
 assert metrics['maximum_site_error_m']<.0011
 assert np.linalg.norm(error[0])>0
 assert log['reported_iterations']<=200

